# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor: grava dados de mercado e lê a chave de IA criptografada
SUPABASE_SERVICE_ROLE_KEY=

# Segredo para criptografar as chaves de IA dos usuários (qualquer texto longo e aleatório)
AI_KEY_SECRET=
# Chave da plataforma, usada só por contas com "IA incluída" (liberadas pelo administrador)
ANTHROPIC_API_KEY=
# Opcional: modelos
AI_MODEL=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5

# Protege a rota do cron (/api/cron/market). A Vercel envia "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# Opcional: taxas do Tesouro Direto via brapi.dev (plano pago). Sem token, valem as últimas taxas salvas.
BRAPI_TOKEN=
